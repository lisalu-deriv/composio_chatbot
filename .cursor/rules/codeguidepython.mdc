Type Annotation Rules
# ✅ CORRECT: Complete type annotations
from typing import Optional, List, Dict, Any

def process_data(
    input_data: str,
    config: Optional[Config] = None,
    max_items: int = 100
) -> Dict[str, Any]:
    
