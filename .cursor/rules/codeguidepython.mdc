Dependency Injection
# ✅ CORRECT: FastAPI dependency injection
@asynccontextmanager
async def lifespan(app: FastAPI):
    # Initialize services
    repository = Repository()
    service = Service(repository)
    
    app_state.update({
        "service": service,
        "repository": repository
    })
    yield

def get_service() -> Service:
    return app_state["service"]

@router.post("/endpoint")
async def endpoint(service: Service = Depends(get_service)):
    return await service.process()
🎯 TYPE SAFETY REQUIREMENTS
Mandatory Type Annotations
# ✅ CORRECT: Complete type safety
from typing import Optional, List, Dict, Any, Union

class Service:
    def __init__(self, client: APIClient) -> None:
        self.client = client
    
    async def process_items(
        self, 
        items: List[str], 
        config: Optional[Config] = None,
        max_items: int = 100
    ) -> Dict[str, Any]:
        
        if config is None:  # ✅ Always validate Optional
            config = default_config
            
        results: List[Result] = []
        for item in items[:max_items]:
            result = await self.client.process(item)
            results.append(result)
            
        return {"results": results, "count": len(results)}
Type Safety Checklist
✅ All parameters have type hints
✅ All return types specified
✅ Optional types: Optional[Type] = None
✅ Generic types: List[str], Dict[str, Any]
✅ None validation before access
✅ Enum usage over string constants
🚀 PERFORMANCE GUIDELINES
Async/Await Patterns
# ✅ CORRECT: True parallelization
async def process_parallel(items: List[Item]) -> List[Result]:
    semaphore = asyncio.Semaphore(settings.max_concurrent)
    
    async def process_single(item: Item) -> Result:
        async with semaphore:
            return await expensive_api_call(item)
    
    # All items processed in parallel
    tasks = [process_single(item) for item in items]
    results = await asyncio.gather(*tasks)
    
    # Preserve order if needed
    results.sort(key=lambda x: x.original_index)
    return results

# ❌ WRONG: Sequential processing
async def process_sequential(items: List[Item]) -> List[Result]:
    results = []
    for item in items:  # One at a time - slow!
        result = await expensive_api_call(item)
        results.append(result)
    return results
Progress Tracking Standards
# ✅ CORRECT: Monotonic progress
class ProgressTracker:
    def __init__(self, total: int, job_id: str):
        self.total = total
        self.completed = 0
        self.job_id = job_id
        self.lock = asyncio.Lock()
    
    async def increment(self):
        async with self.lock:
            self.completed += 1
            progress = self.completed / self.total  # Always 0-1.0
            await update_job_progress(self.job_id, progress)
